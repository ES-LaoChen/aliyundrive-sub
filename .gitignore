# ============================================================
# 阿里云盘订阅转存 · Git 忽略规则
#
# 注意：.env.example / .env.dev / .env.prod 是环境模板（无真实凭证），
#       必须进版本库；仅真实 .env 与 data/ 被忽略。
# ============================================================

# Python 虚拟环境
/.venv/
/venv/
/env/

# 真实环境变量（含凭证，绝不入库）
/.env
# 模板文件保留（以下为显式放行）
!.env.example
!.env.dev
!.env.prod

# 运行时数据（SQLite 单库等）
/data/

# Python 缓存
/__pycache__/
*.py[cod]
*.egg-info/
.eggs/

# 测试 / 覆盖率 / 类型缓存
/.pytest_cache/
/.coverage
/htmlcov/
/.mypy_cache/
/.ruff_cache/

# 日志（启动脚本写入 data/app.log）
*.log

# 启动脚本生成的进程 PID 文件
data/*.pid
*.pid

# IDE / 编辑器
.idea/
.vscode/
*.swp
*.swo
.DS_Store
